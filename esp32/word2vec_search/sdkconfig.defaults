# =============================================================================
# nn20db-word2vec-search — shared sdkconfig defaults
# Applied to all targets.  Target-specific overrides live in:
#   sdkconfig.defaults.esp32s3
# =============================================================================

# -----------------------------------------------------------------------------
# FreeRTOS — generous stack sizes for nn20db search and TCP tasks
# -----------------------------------------------------------------------------
CONFIG_MAIN_TASK_STACK_SIZE=16384
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=2048

# -----------------------------------------------------------------------------
# FAT filesystem — 4 KB sector size, no LFN (8.3 paths only), 2 volumes
# -----------------------------------------------------------------------------
CONFIG_FATFS_SECTOR_4096=y
CONFIG_FATFS_LFN_NONE=y
CONFIG_FATFS_VOLUME_COUNT=2
CONFIG_FATFS_TIMEOUT_MS=10000
CONFIG_FATFS_PER_FILE_CACHE=y

# -----------------------------------------------------------------------------
# VFS — enough slots for SD card + internal flash
# -----------------------------------------------------------------------------
CONFIG_VFS_MAX_COUNT=8

# -----------------------------------------------------------------------------
# TCP/IP stack — lwIP
# -----------------------------------------------------------------------------
CONFIG_LWIP_TCP_MSS=1460
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5744
CONFIG_LWIP_TCP_WND_DEFAULT=5744

# -----------------------------------------------------------------------------
# USB CDC — required for ESP32-S3 (only USB port on Waveshare board)
# -----------------------------------------------------------------------------
CONFIG_ESP_CONSOLE_USB_CDC=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# -----------------------------------------------------------------------------
# Bluetooth — keep fully disabled to minimise power draw during Wi-Fi tests
# -----------------------------------------------------------------------------
# CONFIG_BT_ENABLED is not set

# -----------------------------------------------------------------------------
# Partition table — custom CSV to give the app partition enough room
# -----------------------------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# -----------------------------------------------------------------------------
# LVGL — swap RGB565 byte order to match SPI panel (big-endian on the wire)
# -----------------------------------------------------------------------------
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_36=y
